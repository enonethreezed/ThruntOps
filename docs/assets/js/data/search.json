---
layout: compress
---
[
  {% assign home_page = site.pages | where: 'url', '/' | first %}
  {% if home_page %}
  {
    "title": {{ home_page.title | jsonify }},
    "url": {{ home_page.url | relative_url | jsonify }},
    "categories": "",
    "tags": "",
    "date": "",
    "content": {{ home_page.content | strip_html | normalize_whitespace | jsonify }}
  }{% if site.tabs.size > 0 %},{% endif %}
  {% endif %}
  {% assign search_pages = site.tabs | sort: 'order' %}
  {% for page in search_pages %}
  {
    "title": {{ page.title | jsonify }},
    "url": {{ page.url | relative_url | jsonify }},
    "categories": "",
    "tags": "",
    "date": "",
    "content": {{ page.content | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
